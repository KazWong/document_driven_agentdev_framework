# High-impact operations always require a human decision in interactive Codex sessions.
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden", justification="Never recursively delete the root filesystem.")
prefix_rule(pattern=["sudo"], decision="prompt", justification="Privilege escalation requires explicit human authorization.")
prefix_rule(pattern=["docker"], decision="prompt", justification="The main container controls the host Docker daemon.")
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Publishing changes is a human gate.")
prefix_rule(pattern=["git", "tag"], decision="prompt", justification="Release tags are a human gate.")
prefix_rule(pattern=["git", "reset", "--hard"], decision="prompt", justification="Destructive Git operations require approval.")
prefix_rule(pattern=["git", "clean"], decision="prompt", justification="Destructive Git cleanup requires approval.")
prefix_rule(pattern=["bitbucket-pr", "create"], decision="prompt", justification="Pull-request creation requires a recorded PR approval.")
prefix_rule(pattern=["hardwarectl"], decision="prompt", justification="Device exposure is a human-only R3 operation.")
prefix_rule(pattern=["dd"], decision="prompt", justification="Raw block-device writes require explicit authorization.")
prefix_rule(pattern=["mkfs"], decision="prompt", justification="Filesystem creation is destructive.")
prefix_rule(pattern=["mount"], decision="prompt", justification="Host/device mounts require explicit authorization.")
prefix_rule(pattern=["shutdown"], decision="prompt", justification="Host power operations require explicit authorization.")
prefix_rule(pattern=["reboot"], decision="prompt", justification="Host power operations require explicit authorization.")
prefix_rule(pattern=["openocd"], decision="prompt", justification="Hardware debug/flash access requires approval.")
prefix_rule(pattern=["dfu-util"], decision="prompt", justification="Firmware flashing requires approval.")
prefix_rule(pattern=["avrdude"], decision="prompt", justification="Firmware flashing requires approval.")
prefix_rule(pattern=["west", "flash"], decision="prompt", justification="Firmware flashing requires approval.")
prefix_rule(pattern=["pio", "run", "--target", "upload"], decision="prompt", justification="Firmware upload requires approval.")
prefix_rule(pattern=["platformio", "run", "--target", "upload"], decision="prompt", justification="Firmware upload requires approval.")

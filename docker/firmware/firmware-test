#!/usr/bin/env bash
set -euo pipefail
WORKSPACE="${AGENT_WORKSPACE_ROOT:-/home/kazwong/codes/agents}"
fail() { printf 'firmware-test: %s\n' "$*" >&2; exit 2; }
resolve_project() {
  local candidate="$1" resolved
  [[ "$candidate" = /* ]] || candidate="$WORKSPACE/$candidate"
  resolved="$(realpath -m "$candidate")"
  [[ "$resolved" == "$WORKSPACE"/* ]] || fail "project must be under $WORKSPACE"
  [[ -d "$resolved" ]] || fail "project not found: $resolved"
  printf '%s\n' "$resolved"
}
write_summary() {
  local path="$1" stage="$2" rc="$3" log="$4"
  python3 - "$path" "$stage" "$rc" "$log" <<'PY'
import json, pathlib, sys, datetime
path, stage, rc, log = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
pathlib.Path(path).write_text(json.dumps({"schema_version": 1, "stage": stage, "passed": rc == 0,
    "returncode": rc, "log": log, "hardware_access": False,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()}, indent=2, sort_keys=True) + "\n")
PY
}
smoke() {
  local result="$WORKSPACE/.test-results/firmware-container-smoke/latest"
  rm -rf "$result"; mkdir -p "$result"
  local tmp rc=0
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  {
    arm-none-eabi-gcc --version | head -n1
    qemu-system-arm --version | head -n1
    openocd --version 2>&1 | head -n1
    pio --version
    printf 'void _start(void){for(;;){}}\n' > "$tmp/smoke.c"
    arm-none-eabi-gcc -mcpu=cortex-m3 -mthumb -ffreestanding -nostdlib -Wl,-e,_start "$tmp/smoke.c" -o "$tmp/smoke.elf"
    arm-none-eabi-size "$tmp/smoke.elf"
  } >"$result/smoke.log" 2>&1 || rc=$?
  write_summary "$result/summary.json" "$([[ $rc -eq 0 ]] && echo passed || echo failed)" "$rc" "$result/smoke.log"
  cat "$result/smoke.log"
  return "$rc"
}
test_project() {
  local project result log rc=0
  project="$(resolve_project "$1")"; shift
  result="$project/.test-results/firmware/latest"
  rm -rf "$result"; mkdir -p "$result"
  log="$result/test.log"
  if [[ -x "$project/scripts/ci/firmware-test.sh" ]]; then
    (cd "$project" && ./scripts/ci/firmware-test.sh "$@") >"$log" 2>&1 || rc=$?
  elif [[ -f "$project/platformio.ini" ]]; then
    (cd "$project" && pio run "$@") >"$log" 2>&1 || rc=$?
  else
    printf 'No firmware-test script or platformio.ini found.\n' >"$log"; rc=3
  fi
  write_summary "$result/summary.json" "$([[ $rc -eq 0 ]] && echo passed || echo test_failed)" "$rc" "$log"
  cat "$log"
  return "$rc"
}
case "${1:-}" in
  smoke) shift; smoke "$@" ;;
  test) shift; [[ $# -ge 1 ]] || fail "test requires PROJECT"; test_project "$@" ;;
  *) fail "usage: firmware-test {smoke|test PROJECT [ARGS...]}" ;;
esac
